{
  "name": "@keiya-dev/japan-used-market-mcp",
  "version": "0.5.1",
  "description": "MCP server for Japan's used camera, watch, guitar and model-train shops (Fujiya, WATCHNIAN, Shimokura, Hobbyland Pochi, Hard Off…): search, price stats, price history, change monitors.",
  "mcpName": "io.github.Enu27/japan-used-market",
  "type": "module",
  "bin": {
    "japan-used-market-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./cli": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apify",
    "japan",
    "used-camera",
    "used-watch",
    "leica",
    "grand-seiko",
    "rolex",
    "price-history",
    "used-guitar",
    "fender-japan",
    "musical-instruments",
    "model-train",
    "n-gauge",
    "kato",
    "tomix"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enu27/japan-used-market-mcp.git"
  },
  "homepage": "https://github.com/Enu27/japan-used-market-mcp#readme",
  "author": "keiya_dev",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Enu27/japan-used-market-mcp/issues"
  }
}
